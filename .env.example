# Copy this file to .env and fill it in. NEVER commit .env.
BOT_TOKEN=paste-the-token-from-botfather-here

# Telegram IDs of the mentors (get them from @userinfobot), comma separated
MENTOR_IDS=111111111,222222222

# Hostel timezone (all times are stored in UTC and shown in this zone)
HOSTEL_TZ=Asia/Hong_Kong

# Where the SQLite database lives
DB_PATH=shanyraq.db

# Optional: hostel group chat ID (bot must be admin there). Announcements to
# "everyone" and new events are also posted here. Leave empty to disable.
GROUP_CHAT_ID=
# Optional: separate chat / forum topic for events (defaults to GROUP_CHAT_ID)
EVENTS_CHAT_ID=
EVENTS_THREAD_ID=

# Cleaning day of the week: 0=Mon ... 5=Sat, 6=Sun
DUTY_WEEKDAY=5

# Daily 22:00 quiet-hours reminder (true/false) and its text
QUIET_HOURS_REMINDER=false
QUIET_HOURS_TEXT=🌙 Quiet hours start now (22:00). Please keep the noise down. Thank you!
